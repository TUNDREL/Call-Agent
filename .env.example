# Copy to .env (gitignored). Never commit real values.

# REQUIRED: shared secret Vapi sends with every webhook (Bearer token credential in Vapi).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LINEBACK_WEBHOOK_SECRET=

# Local development only: accept webhooks with no secret.
# LINEBACK_ALLOW_INSECURE=1

# Name shown in notification emails and where requests are stored.
LINEBACK_BUSINESS_NAME=Tundrel
# LINEBACK_DB_PATH=lineback.db

# Owner notifications by email. Without these, requests are saved but nobody is told.
LINEBACK_OWNER_EMAIL=
LINEBACK_SMTP_HOST=
# LINEBACK_SMTP_PORT=587
LINEBACK_SMTP_USER=
LINEBACK_SMTP_PASSWORD=
LINEBACK_SMTP_FROM=
# starttls (port 587), ssl (port 465) or none (local testing only)
# LINEBACK_SMTP_SECURITY=starttls
